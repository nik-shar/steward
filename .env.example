# ===========================================================================
# Jarvis — environment
# Copy to `.env` and fill in. `.env` is gitignored; never commit real keys.
# ===========================================================================

# ---------------------------------------------------------------------------
# Model provider — any OpenAI-compatible endpoint.
#
# Tau's OpenAICompatibleProvider speaks all of them, so switching provider is a
# key + base_url + model change, not a code change.
#
# JARVIS_* is the canonical trio; if JARVIS_API_KEY is unset, the NEBIUS_* trio
# below is used instead. The two trios are never mixed — a key paired with another
# vendor's URL fails as a confusing 401 rather than a clear config error.
# ---------------------------------------------------------------------------
JARVIS_PROVIDER=nebius
JARVIS_API_KEY=
JARVIS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
JARVIS_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Fallback used only when JARVIS_API_KEY is empty.
NEBIUS_API_KEY=your_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Example: OpenRouter instead. Model ids come from https://openrouter.ai/api/v1/models
# JARVIS_PROVIDER=openrouter
# JARVIS_API_KEY=sk-or-v1-...
# JARVIS_BASE_URL=https://openrouter.ai/api/v1
# JARVIS_MODEL=openai/gpt-4o-mini

# ---------------------------------------------------------------------------
# Where personal data lives.
#
# Deliberately OUTSIDE the repository: the SQLite store, JSONL sessions, the
# append-only audit log, and the markdown vault. Point this inside the repo
# only while developing the memory layer itself.
# ---------------------------------------------------------------------------
JARVIS_HOME=~/.jarvis

# Markdown vault Jarvis reads and appends to (daily notes, learning notes).
# JARVIS_VAULT=~/Documents/Jarvis

# ---------------------------------------------------------------------------
# Safety.
#
# Every write-shaped tool call asks for consent. Listing a tool here skips the
# prompt for that tool — start with none and add only what you have watched
# behave through the audit log.
# ---------------------------------------------------------------------------
JARVIS_CONSENT_ALLOWLIST=none

# Hard ceiling on tool-calling turns in a single request. Stops runaway loops
# before they cost you money or write something twice.
JARVIS_MAX_TURNS=12
