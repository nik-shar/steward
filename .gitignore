# ---------------------------------------------------------------------------
# Secrets. `.env` holds live provider keys. Never commit it.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# Data directories, anchored to the repo ROOT on purpose.
#
# These are the second line of defence for the case where STEWARD_HOME is pointed
# inside the tree. They were unanchored once, and an unanchored `memory/` silently
# swallowed the `steward/memory` package for the whole of M0 and M1 — so the memory
# layer was never actually committed. A trailing slash without a leading slash
# matches at any depth; do not drop the leading slashes.
/audit.jsonl
/sessions/
/memory/
/vault/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

